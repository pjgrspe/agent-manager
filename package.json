{
  "name": "agent-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --experimental-strip-types --watch server/index.ts",
    "dev:web": "vite",
    "start": "electron .",
    "desktop": "concurrently -k \"npm:dev:server\" \"npm:dev:web\" \"wait-on http-get://localhost:5173 http-get://127.0.0.1:4311/api/health && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/core/statusParser.test.ts",
    "build": "vite build",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2",
    "wait-on": "^8.0.3"
  }
}
